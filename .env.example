# Pflicht
APP_SECRET=                # min. 32 Zeichen, z. B. `openssl rand -hex 32`
INGEST_TOKEN=              # Bearer-Token, den Fredys HTTP-Adapter mitsendet (`openssl rand -hex 24`)
PUBLIC_URL=http://localhost:8080

# Sicherheitsmodus: true = alles ausfüllen, nie final senden
DRY_RUN=true

# Entwürfe: template (ohne KI, Standard) oder local (Container "llm", Ternary-Bonsai-8B)
LLM_PROVIDER=template
AUTO_DRAFT=true

# Telegram (optional, Etappe 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
APP_PORT=8080
DATA_DIR=./data

# Session-Überwachung: true, sobald der Container "browser" läuft
SESSION_MONITOR=false
